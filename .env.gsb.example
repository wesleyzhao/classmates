# Classmates: copy to .env.local and provision YOUR OWN resources.
APP_PROFILE=gsb
APP_ORIGIN=http://localhost:3137
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Configure Magic Link API/SDK plus the exact deployed host and localhost at Descope.
DESCOPE_PROJECT_ID=
# Alternative to Descope: unset DESCOPE_PROJECT_ID and configure both values below.
RESEND_API_KEY=
EMAIL_FROM=
# Optional game name in custom-sender emails. Does not change Descope's System template.
CLASSMATES_EMAIL_NAME=GSB faces game
# Shared login requests per 24-hour window. Keep below your sender's daily allowance.
CLASSMATES_LOGIN_EMAILS_PER_DAY=900
# Exact domains, comma-separated. Subdomains and wildcard '*' are never implicit.
CLASSMATES_EMAIL_DOMAINS=stanford.edu
CLASSMATES_COHORT_LABEL=Stanford GSB · MBA 2027
# Anonymous access stays disabled. Do not add guest IDs or test switches for ordinary deployment.
# Optional quick landing. All other games remain at /games.
CLASSMATES_LANDING=games
# A guest introduction requires BOTH settings; choose 10-32 approved people outside Git.
# GSB_GUEST_PREVIEW=true
# GSB_GUEST_PERSON_IDS=OPAQUE_IDS_FROM_YOUR_PRIVATE_ROSTER
