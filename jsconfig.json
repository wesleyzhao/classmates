{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["public/**/*.js", "server/**/*.js", "api/**/*.js", "scripts/**/*.js", "tests/**/*.js", "types/**/*.d.ts"],
  "exclude": ["public/vendor/**", "node_modules"]
}
