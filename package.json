{
  "name": "parlor",
  "version": "0.1.0",
  "private": true,
  "description": "Parlor: make and play small multiplayer games with friends. Quiz, board, and card games, mobile first, on Vercel's free tier.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "test": "node --test \"tests/**/*.test.js\" && node scripts/lint-copy.js",
    "test:e2e": "playwright test",
    "check": "tsc -p jsconfig.json",
    "security:check": "node scripts/privacy-check.js",
    "smoke:deployment": "node scripts/deployment-smoke.js",
    "kits": "node scripts/kits.js",
    "new-kit": "node scripts/new-kit.js",
    "new-game": "node scripts/new-game.js",
    "new-deck": "node scripts/new-deck.js",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke.js",
    "deploy": "vercel --prod",
    "build": "node scripts/build.js",
    "dev:gsb": "APP_PROFILE=gsb node --env-file=.env.local server/dev.js",
    "preview:onboarding": "node --env-file=.env.local scripts/gsb/onboarding-preview.js",
    "gsb:migrate": "node --env-file=.env.local scripts/gsb/migrate.js",
    "gsb:door": "node --env-file=.env.local scripts/gsb/door.js",
    "gsb:import": "node --env-file=.env.local scripts/gsb/import.js",
    "gsb:import-roster": "node --env-file-if-exists=.env.local scripts/gsb/import-roster.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "typescript": "5.9.3"
  }
}
